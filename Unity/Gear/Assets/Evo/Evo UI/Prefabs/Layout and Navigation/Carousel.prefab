  currentIndex: 0
  items:
  - title: Slides on a timer
    description: The ring fills while an item is up. When it's full, the next one
      slides in.
    background: {fileID: 21300000, guid: 0221a5a5f8f977f4c8a81763d9972446, type: 3}
    onClick:
      m_PersistentCalls:
        m_Calls: []
  - title: Jump to any item
    description: Click an indicator to go straight to its item. The timer starts
      over.
    background: {fileID: 21300000, guid: 6b9e7093e94dfd846a83c7e29affcee2, type: 3}
    onClick:
      m_PersistentCalls:
        m_Calls: []
  - title: Add a click action
    description: Items with an On Click event show this button. Here it goes back
      to the first item.
    background: {fileID: 21300000, guid: aac109089a640c248b66cc0d6bae3931, type: 3}
    onClick:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 6042151667472312243}
