/* Toolbar */
.catalog-toolbar {
    height: 30px;
    flex-shrink: 0;
    align-items: center;
    padding-left: 4px;
}

.catalog-search {
    width: 240px;
    min-width: 120px;
    flex-shrink: 1;
}

.catalog-toolbar-menu {
    align-self: stretch;
    flex-shrink: 0;
    padding: 0 8px 0 10px;
}

.catalog-toolbar-menu > .unity-toolbar-menu__arrow {
    margin-left: 6px;
}

.catalog-split {
    flex-grow: 1;
}

/* Navigation */
.catalog-nav {
    min-width: 150px;
    background-color: var(--evo-panel);
}

.catalog-nav__content {
    padding: 4px 6px 10px 6px;
}

.catalog-nav__header {
    margin: 10px 8px 4px 8px;
}

.catalog-nav__row {
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding: 0 8px;
    margin-bottom: 1px;
    border-radius: 4px;
    transition-duration: 0.1s;
}

.catalog-nav__row:hover {
    background-color: var(--evo-hover);
}

.catalog-nav__row--selected,
.catalog-nav__row--selected:hover {
    background-color: var(--evo-accent-soft);
}

.catalog-nav__row--empty {
    opacity: 0.4;
}

.catalog-nav__icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: 8px;
}

.catalog-nav__label {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.catalog-nav__count {
    flex-shrink: 0;
    margin-left: 6px;
    font-size: 10px;
    color: var(--evo-muted);
}

/* Grid */
.catalog-content {
    flex-grow: 1;
}

.catalog-grid-scroll {
    flex-grow: 1;
}

.catalog-grid-scroll__content {
    padding: 10px 4px 12px 12px;
}

.catalog-section {
    margin-bottom: 10px;
}

.catalog-section__header {
    height: 24px;
    margin: 0 10px 6px 2px;
}

.catalog-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.catalog-card {
    margin: 0 8px 10px 0;
    padding: 4px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    transition-duration: 0.1s;
}

.catalog-card:hover {
    background-color: var(--evo-hover);
}

.catalog-card--selected,
.catalog-card--selected:hover {
    background-color: var(--evo-accent-soft);
    border-color: var(--evo-accent);
}

.catalog-card__preview {
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--evo-border);
}

/* Previews fill their frame. Shared by cards, the details preview, and variants. */
.catalog-card__image,
.catalog-details__image,
.catalog-variant__image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.catalog-card__placeholder {
    width: 32px;
    height: 32px;
    opacity: 0.35;
}

.catalog-card--failed .catalog-card__placeholder {
    opacity: 0.7;
}

.catalog-card__favorite {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 22px;
    height: 22px;
    align-items: center;
    justify-content: center;
    border-radius: 11px;
    background-color: rgba(0, 0, 0, 0.45);
    opacity: 0;
    transition-duration: 0.1s;
}

.catalog-card:hover > .catalog-card__favorite,
.catalog-card__favorite--on {
    opacity: 1;
}

.catalog-card__favorite:hover {
    background-color: rgba(0, 0, 0, 0.7);
}

.catalog-card__favorite-icon {
    width: 14px;
    height: 14px;
}

.catalog-card__label {
    margin: 5px 2px 1px 2px;
    -unity-text-align: middle-center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Empty state: the grid scrolls, so it can't center vertically and starts lower instead */
.catalog-grid-scroll .evo-empty {
    padding-top: 48px;
}

/* Status bar */
.catalog-status {
    flex-shrink: 0;
    height: 22px;
    padding: 0 10px;
    border-top-width: 1px;
    border-top-color: var(--evo-border);
    font-size: 11px;
    color: var(--evo-muted);
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Details */
.catalog-details {
    background-color: var(--evo-panel);
}

.catalog-details__content {
    padding: 10px 10px 16px 10px;
}

.catalog-details__empty {
    margin-top: 40px;
    padding: 0 12px;
    color: var(--evo-muted);
    -unity-text-align: middle-center;
    white-space: normal;
}

.catalog-details__preview {
    height: 160px;
    margin-bottom: 10px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--evo-border);
}

.catalog-details__placeholder {
    width: 48px;
    height: 48px;
    opacity: 0.35;
}

.catalog-details__title-row {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 6px;
}

.catalog-details__title {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 16px;
    -unity-font-style: bold;
    white-space: normal;
}

/* Lines up with the title's first line, so long names wrap below it */
.evo-window .catalog-details__docs {
    width: 22px;
    height: 22px;
    margin: 0 -2px 0 6px;
}

.catalog-details__docs > .evo-icon-button__icon {
    width: 16px;
    height: 16px;
}

.catalog-details__meta {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 8px;
}

.catalog-details__description {
    white-space: normal;
    margin-bottom: 4px;
}

.catalog-details__heading {
    margin: 12px 0 6px 0;
}

.catalog-details__variants {
    flex-direction: row;
    flex-wrap: wrap;
}

.catalog-variant {
    width: 64px;
    height: 40px;
    margin: 0 6px 6px 0;
    overflow: hidden;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--evo-border);
    align-items: center;
    justify-content: center;
}

.catalog-variant:hover {
    border-color: var(--evo-border-hover);
}

.catalog-variant--current,
.catalog-variant--current:hover {
    border-width: 2px;
    border-color: var(--evo-accent);
}

.catalog-variant__image--icon {
    left: 20px;
    top: 8px;
    right: 20px;
    bottom: 8px;
    opacity: 0.35;
}

.evo-window .catalog-details__placement {
    margin-bottom: 6px;
}

.catalog-details__placement > .unity-base-field__label {
    min-width: 70px;
    width: 70px;
}

.catalog-details__create-row {
    flex-direction: row;
}

.evo-window .catalog-details__favorite {
    width: 28px;
    height: 28px;
    margin-right: 6px;
    padding: 0;
}

.evo-window .catalog-details__favorite > .unity-button__image {
    width: 16px;
    height: 16px;
}

.evo-window .catalog-details__create {
    flex-grow: 1;
}

.evo-window .catalog-details__target {
    margin: 0 0 6px 0;
}
