/* Styler Browser and ID Migrator. Shared pieces live in EvoEditorUITK.uss. */

/* Header */
.styler-rename-field {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 100%;
    height: 24px;
    margin: 0 4px 0 -4px;
}

.styler-rename-field > .unity-base-text-field__input {
    padding-left: 5px;
    font-size: 15px;
    -unity-font-style: bold;
}

.styler-palette {
    flex-direction: row;
    height: 12px;
    margin: 9px 4px 0 0;
    border-width: 1px;
    border-color: var(--evo-border);
    border-radius: 3px;
    overflow: hidden;
}

.styler-palette__swatch {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 1px;
}

/* Preset items */
.styler-content {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

.styler-items {
    flex-grow: 1;
}

.styler-items__content {
    padding: 2px 0 12px 0;
}

/* Apply */
.styler-footer__heading-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 16px;
    margin-bottom: 5px;
}

.styler-footer__heading-row > .evo-heading {
    flex-shrink: 0;
    margin: 0 8px 0 2px;
}

/* The 22px toggle overhangs the 16px row, with its box lined up with the right edge of the scopes below */
.evo-window .styler-children-toggle {
    flex-shrink: 1;
    min-width: 0;
    margin: -3px -4px -3px 0;
}

.styler-apply-row {
    flex-direction: row;
    margin-top: 7px;
}

/* Nothing shows above the row while the options are folded and there's no status */
.styler-apply-row--alone {
    margin-top: 0;
}

/* While folded, a status message is the first thing in the footer */
.evo-window .styler-footer--folded > .evo-status {
    margin-top: 0;
}

.evo-window .styler-options-button {
    width: 28px;
    height: 28px;
    margin-right: 6px;
    padding: 0;
}

/* Points up to the folded options, and down to fold them away */
.evo-window .styler-options-button > .unity-button__image {
    rotate: 180deg;
}

.evo-window .styler-options-button--open > .unity-button__image {
    rotate: 0deg;
}

/* Takes the rest of the row and cuts long object names short instead of growing past the window */
.evo-window .styler-apply {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
}
